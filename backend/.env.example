# fb-video-downloader configuration (NFR-007) — all optional, defaults shown.
# Copy to .env and adjust; never commit .env.

MAX_CONCURRENT_DOWNLOADS=5
EXTRACT_CONCURRENCY=8
MAX_JOBS_PER_CLIENT=3
MAX_QUEUED_JOBS=10
JOB_TTL_SECONDS=1800
CLEANUP_INTERVAL_SECONDS=60
INFO_CACHE_TTL_SECONDS=300
INFO_CACHE_MAX_ENTRIES=500
MAX_DOWNLOAD_BYTES=2147483648
MIN_FREE_DISK_MB=1024
DOWNLOADS_DIR=./downloads

#IP_HASH_SALT=
LOG_LEVEL=INFO
